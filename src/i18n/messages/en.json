  "help": {
    "title": "Help Center",
    "back": "Back",
    "welcome": "How can we help you?",
    "subtitle": "Browse FAQs below or contact us directly",
    "sections": {
      "gettingStarted": {
        "title": "Getting Started",
        "icon": "🚀",
        "q1": {
          "question": "What is MeetMind?",
          "answer": "MeetMind is an AI learning assistant created by a team from Tsinghua and Peking University. It provides every student with an intelligent study companion that listens, remembers, and explains clearly. Features include classroom recording, speech-to-text, AI tutoring, and timeline review - making class content always accessible and ready for questions."
        },
        "q2": {
          "question": "How do I get started?",
          "answer": "1. Register or log in to your account\n2. Click 'Start Recording' or 'Upload Audio' on the homepage\n3. Wait for processing to complete\n4. View transcribed text and smart summary\n5. Use the AI chat feature to ask questions"
        },
        "q3": {
          "question": "What audio formats are supported?",
          "answer": "We support common audio formats including MP3, WAV, M4A, FLAC, OGG, etc. For best experience, keep individual files under 100MB and duration under 2 hours."
        }
      },
      "features": {
        "title": "Features",
        "icon": "💡",
        "q1": {
          "question": "How accurate is speech-to-text?",
          "answer": "We use advanced AI speech recognition technology with accuracy over 95% for clear Mandarin recordings. Recording quality, background noise, and accents can affect accuracy. We recommend using a clear recording device and minimizing environmental noise."
        },
        "q2": {
          "question": "How is the smart summary generated?",
          "answer": "AI analyzes the transcribed text to automatically extract key information and generate structured summaries including main points, key content, and conclusions. You can quickly understand the essence of the content from the summary."
        },
        "q3": {
          "question": "How do I use the AI chat feature?",
          "answer": "After processing audio, you can ask AI any questions related to the content in the chat area. For example: 'What are the key points of this lesson?' or 'Can you explain the third concept in detail?' AI will answer based on the content."
        },
        "q4": {
          "question": "Can I edit the transcribed text?",
          "answer": "Yes. If you find errors in the transcription, you can click directly on the text to edit and correct it. Changes are automatically saved."
        }
      },
      "account": {
        "title": "Account",
        "icon": "👤",
        "q1": {
          "question": "How do I update my profile?",
          "answer": "Click the avatar in the top right corner, go to 'Profile' page to update nickname, avatar, linked email/phone, and other information."
        },
        "q2": {
          "question": "What if I forget my password?",
          "answer": "Click 'Forgot Password' on the login page. Verify your identity using your registered email or phone number, then you can reset your password."
        },
        "q3": {
          "question": "How is my privacy protected?",
          "answer": "We highly value user privacy. Your uploaded audio and generated content are for your personal use only and won't be used for other purposes. See our Privacy Policy for details."
        }
      },
      "other": {
        "title": "Other Questions",
        "icon": "❓",
        "q1": {
          "question": "What if processing is slow?",
          "answer": "Processing speed depends on audio duration and server load. Generally, 1 hour of audio takes 3-5 minutes to process. If waiting too long, try refreshing the page or try again later."
        },
        "q2": {
          "question": "How do I report issues or suggestions?",
          "answer": "We welcome your feedback! Submit via the 'Feedback' page or email originedu@meetmind.online."
        },
        "q3": {
          "question": "Are there usage limits?",
          "answer": "To ensure service quality, we have reasonable rate limits on API calls. If you need higher usage, please contact us."
        }
      }
    },
    "contact": {
      "title": "Didn't find your answer?",
      "subtitle": "Our team is ready to help you",
      "feedback": "Submit Feedback",
      "email": "Send Email"
    }
