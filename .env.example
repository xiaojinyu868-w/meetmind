# MeetMind environment template
# Copy to .env.local and fill your own keys.

# ===== App/Auth basics =====
# Generate a long random secret for JWT signing.
# JWT_SECRET=replace-with-a-long-random-string
# JWT_EXPIRES_IN=7200
# JWT_REFRESH_EXPIRES_IN=604800

# ============================================================
# LLM 模型（单一注册表，环境变量驱动）
# ------------------------------------------------------------
# 模型定义集中在 src/lib/config/app.config.ts；「启用哪些 provider」由各 *_API_KEY 决定，
# 「每个用途默认用哪个模型」由下面的 *_MODEL 环境变量声明，未配则回落到注册表里 recommended 的模型。
# 上新模型：在 app.config.ts 加一条 ModelConfig + 在这里把对应用途 env 指向它，即可，无需改散落字面量。
#
# 当前注册表内已知 model id：
#   StepFun  : step-3.7-flash
#   DeepSeek : DeepSeek-V4-Flash / DeepSeek-V4-Pro（官方 api.deepseek.com 只认小写，代码内部自动转）
#   Qwen     : qwen3.7-plus
# ============================================================

# ----- StepFun -----
# STEPFUN_API_KEY=your-stepfun-api-key-here
# STEPFUN_BASE_URL=https://api.stepfun.com/v1

# ----- DashScope / Qwen -----
DASHSCOPE_API_KEY=sk-your-api-key-here
# DashScope base_url 默认 https://dashscope.aliyuncs.com/compatible-mode/v1，一般无需显式设置

# ----- DeepSeek 官方 -----
DEEPSEEK_API_KEY=sk-your-api-key-here
DEEPSEEK_BASE_URL=https://api.deepseek.com

# ----- 各用途默认模型（留空则回落到注册表 recommended）-----
# LLM_MODEL=        # 主默认（同桌 / 复习 / 学习应用通用）
# WORKSHOP_MODEL=   # 课堂工坊学习应用（留空回落 LLM_MODEL）
# TUTOR_MODEL=      # Tutor agent（留空回落 LLM_MODEL）
# VISION_MODEL=     # 多模态/视觉（留空回落注册表第一个多模态模型）
# LLM_BASE_URL=     # 仅 Qwen/DashScope 自定义网关时设置

# Document parsing (pdf/docx) via DashScope file extraction + qwen-doc
# DASHSCOPE_DOC_BASE_URL defaults to LLM_BASE_URL
# DASHSCOPE_DOC_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# DASHSCOPE_DOC_MODEL=qwen-doc-turbo
# DASHSCOPE_DOC_TIMEOUT_MS=180000
# DASHSCOPE_DOC_RETRIES=2
# DASHSCOPE_DOC_MAX_TOKENS=12000
# DASHSCOPE_DOC_FILE_READY_MAX_WAIT_MS=120000
# DASHSCOPE_DOC_FILE_READY_POLL_MS=1500

# Realtime ASR
DASHSCOPE_ASR_WS_MODEL=qwen3-asr-flash-realtime
DASHSCOPE_ASR_WS_SR=16000
DASHSCOPE_ASR_WS_VAD_SILENCE_MS=500
ASR_DRAFT_FLUSH_MS=800
ASR_DEDUP_SIMILARITY=0.95
ASR_DEDUP_GAP_MS=1500

# Speaker Diarization (录音后说话人分离)
# 用 DashScope 非实时 Fun-ASR API + diarization_enabled: true
# 录音结束后自动触发，不影响实时转录
# DASHSCOPE_DIARIZATION_MODEL=fun-asr

# ===== 腾讯云实时语音识别（说话人分离）=====
# 用于课堂"多人会议"模式——实时声纹聚类，支持最多 10 个说话人分离
# 用户在课堂首屏选"多人会议"时启用，走 wss://asr.cloud.tencent.com
# 不配置则"多人会议"选项不生效
TENCENT_ASR_APP_ID=your-app-id
TENCENT_ASR_SECRET_ID=your-secret-id
TENCENT_ASR_SECRET_KEY=your-secret-key

# ===== 实时说话人分离（多人课堂） =====
# 走 server.js 的 /api/asr-stream-speaker WebSocket → 腾讯云 16k_zh_en_speaker 引擎。
# 与 DashScope 路径互斥：开启后实时转录会带 speakerId（0-9），不开启则保持默认行为。
# 1) 在腾讯云控制台开通「语音识别」服务，进入 API 密钥管理新建密钥
# 2) 把 AppID / SecretId / SecretKey 填到 .env.local
# 3) 在客户端录音面板切换到「多人会议」即可启用
TENCENT_ASR_APP_ID=
TENCENT_ASR_SECRET_ID=
TENCENT_ASR_SECRET_KEY=

# ===== 实时语音同桌 / 「聊聊你想要的」打电话模式 =====
# 走 server.js 的 /api/tutor-call WebSocket → DashScope omni realtime。
# 默认模型为 qwen3.5-omni-plus-realtime（已支持语义级 VAD）。
# DASHSCOPE_OMNI_REALTIME_MODEL=qwen3.5-omni-plus-realtime
# DASHSCOPE_OMNI_REALTIME_TRANSCRIPT_MODEL=gummy-realtime-v1
# DASHSCOPE_OMNI_REALTIME_VOICE=Ethan
#
# 抗噪 / 抗打断三件套（M11 升级）
#   - DASHSCOPE_OMNI_TURN_DETECTION：'semantic_vad'（默认，能区分附和声/咳嗽 vs 真说话）
#                                    或 'server_vad'（旧版，纯音量阈值）
#   - DASHSCOPE_OMNI_NOISE_REDUCTION：'near_field'（默认，桌面/手机贴麦）/ 'far_field'（远场） / 'off'
#   - DASHSCOPE_OMNI_SILENCE_DURATION_MS：判断"停顿即一句结束"的静音阈值（默认 1500ms）
#   - DASHSCOPE_OMNI_VAD_THRESHOLD：0-1，越高越不容易被打断（默认 0.5）
# DASHSCOPE_OMNI_TURN_DETECTION=semantic_vad
# DASHSCOPE_OMNI_NOISE_REDUCTION=near_field
# DASHSCOPE_OMNI_SILENCE_DURATION_MS=1500
# DASHSCOPE_OMNI_VAD_THRESHOLD=0.5

# Subdomain deployment example
# PORT=3002

# Public base URL for offline ASR/media callbacks (required in deployed env)
# PUBLIC_DOMAIN=capture.meetmind.online
# PUBLIC_HOST=capture.meetmind.online
# PUBLIC_PROTOCOL=https

# Transcript post-correction
TRANSCRIPT_CORRECTION_MODE=layered
TRANSCRIPT_LIGHT_MODEL=qwen-turbo
TRANSCRIPT_FALLBACK_MODEL=qwen-plus
TRANSCRIPT_ENABLE_MAX_FALLBACK=false

# ===== Volcengine Ark (optional) =====
# VOLCENGINE_ARK_API_KEY=your-ark-api-key
# VOLCENGINE_ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
# VOLCENGINE_ARK_MODEL=your-ark-model-or-endpoint-id

# ===== Relay Gateway (optional) =====
# RELAY_API_KEY=your-relay-api-key
# RELAY_BASE_URL=https://your-relay-host/v1
# RELAY_MODEL=gemini-3-pro-image-preview

# ===== CommonStack Echo (optional but required for daily echo) =====
# Used by the daily "回声" feature.
# COMMONSTACK_ECHO_API_KEY=your-commonstack-api-key
# COMMONSTACK_ECHO_BASE_URL=https://api.commonstack.ai/v1
# COMMONSTACK_ECHO_MODEL=google/gemini-3-flash-preview
# COMMONSTACK_ECHO_TEMPERATURE=0.2
# ENABLE_ECHO_MANUAL_TRIGGER=true
# NEXT_PUBLIC_ENABLE_ECHO_MANUAL_TRIGGER=true

# ===== Volcengine Podcast (optional) =====
# VOLCENGINE_PODCAST_APP_ID=your-app-id
# X-Api-Access-Key should use your Volcengine console Access Token
# VOLCENGINE_PODCAST_ACCESS_TOKEN=your-access-token
# VOLCENGINE_PODCAST_SECRET_KEY=your-secret-key
# VOLCENGINE_PODCAST_RESOURCE_ID=volc.service_type.10050
# VOLCENGINE_PODCAST_APP_KEY=aGjiRDfUWi

# ===== Firecrawl（网页文章提取，可绕过微信公众号反爬）=====
# 免费版 500 credits/月，提取一篇文章约 1 credit。
# 配置后作为所有平台文章提取的首选策略；不配置则回落到 OpenClaw / Jina / 本地 fetch。
# FIRECRAWL_API_KEY=fc-your-key-here

# ===== OpenClaw Gateway（微信公众号文章爬取，即将弃用）=====
# 已deprecated：Firecrawl 可提供更稳定的微信文章提取，无需额外 Gateway 服务器。
# 保留作为 fallback，直到 Firecrawl 完全验证稳定后移除。
# OPENCLAW_GATEWAY_URL=https://directly-chosen-scrunch.ngrok-free.dev/v1/chat/completions
# OPENCLAW_TOKEN=dc0d48dca00d7645611ba3cd13324fecadf740eb021c6c73

# ===== OpenBiliClaw 信息流后端（M15 Phase 2，可选）=====
# 本地部署的 OpenBiliClaw 后端地址。在线时信息流 tab 追加 B站视频推荐。
# 不配置时默认 http://127.0.0.1:8420；OpenBiliClaw 离线时降级到 MeetMind 自带信息流。
# OPENBILICLAW_API_URL=http://127.0.0.1:8420

# Optional external services
# NEXT_PUBLIC_NOTEBOOK_API=http://localhost:5055
# ENABLE_NOTEBOOK=true

# Optional auth entry toggles
# NEXT_PUBLIC_ENABLE_WECHAT_LOGIN=true
# WECHAT_APP_ID=your-wechat-app-id
# WECHAT_APP_SECRET=your-wechat-app-secret
# WECHAT_REDIRECT_URI=https://capture.meetmind.online/api/auth/wechat/callback

# ===== WeChat Official Account capture (optional) =====
# Used for service-account based note ingestion.
# WECHAT_MP_TOKEN=your-service-account-token
# WECHAT_MP_PUBLIC_BASE_URL=https://capture.meetmind.online

# ===== Frontend ASR tuning (optional) =====
# NEXT_PUBLIC_ASR_DEDUP_SIMILARITY=0.95
# NEXT_PUBLIC_ASR_DEDUP_GAP_MS=1500
# NEXT_PUBLIC_ASR_AUTO_GAIN_CONTROL=true
# NEXT_PUBLIC_ASR_ECHO_CANCELLATION=false
# NEXT_PUBLIC_ASR_NOISE_SUPPRESSION=true
# NEXT_PUBLIC_TRANSCRIPT_LIGHT_MODEL=qwen-turbo
# NEXT_PUBLIC_TRANSCRIPT_FALLBACK_MODEL=qwen-plus

# ===== Observability (Sentry) =====
# Leave empty to disable Sentry; pino structured logging still works without DSN.
# SENTRY_DSN=https://example@o0.ingest.sentry.io/0
# NEXT_PUBLIC_SENTRY_DSN=https://example@o0.ingest.sentry.io/0
# SENTRY_ENV=development
# SENTRY_RELEASE=
# SENTRY_TRACES_SAMPLE_RATE=0.2                  # server: prod 0.2 / dev 1.0
# NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0.1      # client: prod 0.1 / dev 1.0
# SENTRY_AI_RECORD_INPUTS=false                  # 禁用默认；合规审计时再开
# SENTRY_AI_RECORD_OUTPUTS=false

# ===== Structured logs =====
# LOG_LEVEL=info      # debug / info / warn / error
# LOG_JSON=true       # force JSON output in dev (default: pretty)

# ===== B站 / 视频导入 =====
# B站导入需要 Cookie 才能稳定拉取音频/字幕。匿名请求大概率被 -352 风控拦截。
# 用户可在「设置 → 视频导入」配置自己的 Cookie（前端自动传给后端）；
# 以下是服务器全局兜底 Cookie（用于未登录用户或全局优先）。
# BILIBILI_COOKIE=SESSDATA=xxx; bili_jct=xxx; DedeUserID=xxx
# 策略：bili-native-first（自研 API 优先）或 yt-dlp-first
# VIDEO_IMPORT_STRATEGY=bili-native-first
# VIDEO_IMPORT_ENABLE_YTDLP_FALLBACK=true
# yt-dlp 二进制路径（默认从 PATH 查找）
# YT_DLP_BIN=yt-dlp
# 超时/重试（毫秒）
# BILI_FETCH_TIMEOUT_MS=12000
# BILI_FETCH_MAX_RETRIES=2
# BILI_AUDIO_DOWNLOAD_TIMEOUT_MS=600000

# ===== Smoke / e2e 测试绕过限流 =====
# 仅当此 env 已设且请求 header X-Smoke-Bypass 匹配时，applyRateLimit 直接放行。
# 用于 make smoke / make smoke-intent 等真实端到端测试，避免被项目自有 rate-limiter 阻挡。
# **线上请勿配置**。本地按需开启即可。
# SMOKE_BYPASS_TOKEN=
