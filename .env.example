# MeetMind environment template
# Copy to .env.local and fill your own keys.

# ===== DashScope (required) =====
DASHSCOPE_API_KEY=sk-your-api-key-here

# LLM defaults
LLM_MODEL=qwen3-vl-plus-2025-12-19
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# Document parsing (pdf/docx) via DashScope file extraction + qwen-doc
# DASHSCOPE_DOC_BASE_URL defaults to LLM_BASE_URL
# DASHSCOPE_DOC_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# DASHSCOPE_DOC_MODEL=qwen-doc-turbo
# DASHSCOPE_DOC_TIMEOUT_MS=180000
# DASHSCOPE_DOC_RETRIES=2
# DASHSCOPE_DOC_MAX_TOKENS=12000
# DASHSCOPE_DOC_FILE_READY_MAX_WAIT_MS=120000
# DASHSCOPE_DOC_FILE_READY_POLL_MS=1500

# Realtime ASR
DASHSCOPE_ASR_WS_MODEL=qwen3-asr-flash-realtime
DASHSCOPE_ASR_WS_SR=16000
DASHSCOPE_ASR_WS_VAD_SILENCE_MS=500
ASR_DRAFT_FLUSH_MS=800
ASR_DEDUP_SIMILARITY=0.95
ASR_DEDUP_GAP_MS=1500

# Subdomain deployment example
# PORT=3002

# Public base URL for offline ASR/media callbacks (required in deployed env)
# PUBLIC_DOMAIN=capture.meetmind.online
# PUBLIC_HOST=capture.meetmind.online
# PUBLIC_PROTOCOL=https

# Transcript post-correction
TRANSCRIPT_CORRECTION_MODE=layered
TRANSCRIPT_LIGHT_MODEL=qwen-turbo
TRANSCRIPT_FALLBACK_MODEL=qwen-plus
TRANSCRIPT_ENABLE_MAX_FALLBACK=false

# ===== Volcengine Ark (optional) =====
# VOLCENGINE_ARK_API_KEY=your-ark-api-key
# VOLCENGINE_ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
# VOLCENGINE_ARK_MODEL=your-ark-model-or-endpoint-id

# ===== Relay Gateway (optional) =====
# RELAY_API_KEY=your-relay-api-key
# RELAY_BASE_URL=https://your-relay-host/v1
# RELAY_MODEL=gemini-3-pro-image-preview

# ===== Volcengine Podcast (optional) =====
# VOLCENGINE_PODCAST_APP_ID=your-app-id
# X-Api-Access-Key should use your Volcengine console Access Token
# VOLCENGINE_PODCAST_ACCESS_TOKEN=your-access-token
# VOLCENGINE_PODCAST_SECRET_KEY=your-secret-key
# VOLCENGINE_PODCAST_RESOURCE_ID=volc.service_type.10050
# VOLCENGINE_PODCAST_APP_KEY=aGjiRDfUWi

# Optional external services
# NEXT_PUBLIC_NOTEBOOK_API=http://localhost:5055
# ENABLE_NOTEBOOK=true

# Optional auth entry toggles
# NEXT_PUBLIC_ENABLE_WECHAT_LOGIN=true
# WECHAT_APP_ID=your-wechat-app-id
# WECHAT_APP_SECRET=your-wechat-app-secret
# WECHAT_REDIRECT_URI=https://capture.meetmind.online/api/auth/wechat/callback

# ===== WeChat Official Account capture (optional) =====
# Used for service-account based note ingestion.
# WECHAT_MP_TOKEN=your-service-account-token
# WECHAT_MP_PUBLIC_BASE_URL=https://capture.meetmind.online
