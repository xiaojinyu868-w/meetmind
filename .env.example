# MeetMind environment template
# Copy to .env.local and fill your own keys.

# ===== App/Auth basics =====
# Generate a long random secret for JWT signing.
# JWT_SECRET=replace-with-a-long-random-string
# JWT_EXPIRES_IN=7200
# JWT_REFRESH_EXPIRES_IN=604800

# ===== Internal API =====
# server.js（纯 Node ASR WS 代理）回调 Next API 的共享密钥。
# 用途：积分 Phase 2 —— /api/asr-stream 连接关闭时 POST /api/points/settle-asr 结算录课分钟。
# 未配置时：settle 路由返回 503 且 server.js 跳过结算（ASR 转写不受影响，积分不扣）。
# INTERNAL_API_SECRET=replace-with-a-long-random-string

# ============================================================
# LLM 模型（单一注册表，环境变量驱动）
# ------------------------------------------------------------
# 模型定义集中在 src/lib/config/app.config.ts；「启用哪些 provider」由各 *_API_KEY 决定，
# 「每个用途默认用哪个模型」由下面的 *_MODEL 环境变量声明，未配则回落到注册表里 recommended 的模型。
# 上新模型：在 app.config.ts 加一条 ModelConfig + 在这里把对应用途 env 指向它，即可，无需改散落字面量。
#
# 当前注册表内已知 model id：
#   StepFun  : step-3.7-flash
#   DeepSeek : DeepSeek-V4-Flash / DeepSeek-V4-Pro（官方 api.deepseek.com 只认小写，代码内部自动转）
#   Qwen     : qwen3.6-flash / qwen3.7-plus
# ============================================================

# ----- StepFun -----
# STEPFUN_API_KEY=your-stepfun-api-key-here
# STEPFUN_BASE_URL=https://api.stepfun.com/v1

# ----- DashScope / Qwen -----
DASHSCOPE_API_KEY=sk-your-api-key-here
# 图像生成（课堂信息图）：默认 DashScope qwen-image-3.0-pro（邀测中，需在百炼模型广场申请开通；
# 未开通时自动降级 qwen-image-plus）；需要更长文渲染稳定性时设 IMAGE_PROVIDER=gemini 退回 Gemini 代理
# IMAGE_PROVIDER=dashscope
# DASHSCOPE_IMAGE_MODEL=qwen-image-3.0-pro
# DASHSCOPE_IMAGE_FALLBACK_MODEL=qwen-image-plus
# 图片摄入 OCR（2026-08 起默认链路）：qwen-vl-ocr 提取文字/公式/图表，复用 DASHSCOPE_API_KEY 认证；
# 长文档图如被 4096 max_tokens 截断，可切 qwen-vl-ocr-latest（上限 32768）
# DASHSCOPE_OCR_MODEL=qwen-vl-ocr
# 可选：OCR 专用 endpoint 覆盖（默认官方 multimodal-generation 同步接口）# DASHSCOPE_OCR_ENDPOINT=
# 板书精讲 narration TTS：复用 DASHSCOPE_API_KEY（SpeechSynthesizer SSE 流式 + 字级时间戳）。
# 默认 cosyvoice-v3-flash + longanhuan + 课堂教学指令（2026-08 试听选型，见 public/demo/tts-samples/）；
# 字级时间戳实测：cosyvoice v2/v3 全系列可用；qwen-audio-3.0-tts-flash 无、plus 加 instruction 后丢失。
# 音频用 wav 容器（mp3 编码器首尾 padding 会在段间拼出可闻缝隙）。
# DASHSCOPE_TTS_MODEL=cosyvoice-v3-flash
# DASHSCOPE_TTS_VOICE=longanhuan
# 指令用 cosyvoice v3 官方固定格式（场景+情感）；显式设空字符串关闭
# DASHSCOPE_TTS_INSTRUCTION=你正在进行课堂教学，你说话的情感是neutral。
# 板演批改多模态模型（Practice 闭环）：默认 qwen3.7-plus（注册表内多模态），复用 DASHSCOPE_API_KEY
# DASHSCOPE_VL_MODEL=qwen3.7-plus
# 拍题开讲链路：默认 one-shot（单次多模态调用出脚本，qwen3.7-plus）；
# BOARD_PHOTO_MODE=staged 切回三段式（审题/解题/生成模型可分别覆盖）；
# 2026-08 实测 qwen3.7-plus 审题质量极佳（样例见 scripts/ab-vision-homework.ts），qwen3-vl-plus 本账号免费额度受限未开通
# BOARD_PHOTO_MODE=oneshot
# BOARD_PHOTO_ONESHOT_MODEL=qwen3.7-plus
# BOARD_PHOTO_VL_MODEL=qwen3.7-plus
# BOARD_PHOTO_SOLVE_MODEL=DeepSeek-V4-Pro
# BOARD_PHOTO_LECTURE_MODEL=DeepSeek-V4-Flash
# OCR 有效字符低于该值自动回退 vision 大模型原链路（默认 20）
# IMAGE_OCR_MIN_CHARS=20
# DashScope base_url 默认 https://dashscope.aliyuncs.com/compatible-mode/v1，一般无需显式设置
# 今日情报外部推荐默认 auto：有 DASHSCOPE_API_KEY 时走国内可达的百炼原生 turbo 搜索；否则走 direct 搜索源。
# FEED_SEARCH_MODE=auto # auto | dashscope | direct
# FEED_SEARCH_MODEL=qwen-plus
# FEED_SEARCH_TIMEOUT_MS=12000

# ----- DeepSeek -----
# 两种接法二选一：
#   a) DeepSeek 官方：DEEPSEEK_API_KEY=sk-...（官方账户余额不足会 402，tutor fallback 到 qwen，post-edit 静默降级原文）
#   b) 百炼托管（推荐，账单并入阿里云）：DEEPSEEK_API_KEY 填 DASHSCOPE 的 key，
#      DEEPSEEK_BASE_URL 填 https://dashscope.aliyuncs.com/compatible-mode/v1
#      （百炼已上架 deepseek-v4-flash / deepseek-v4-pro，价格与官方一致；代码统一小写发送模型名，无需改码）
DEEPSEEK_API_KEY=sk-your-api-key-here
DEEPSEEK_BASE_URL=https://api.deepseek.com

# ----- 各用途默认模型（留空则回落到注册表 recommended）-----
# LLM_MODEL=        # 主默认（同桌 / 复习 / 学习应用通用）
# WORKSHOP_MODEL=   # 课堂工坊学习应用（留空回落 LLM_MODEL）
# TUTOR_MODEL=      # Tutor agent（留空回落 LLM_MODEL）
# TUTOR_QUICK_MODEL= # Ask MeetMind「直接问」（留空自动选择 TUTOR_MODEL 同 provider 的 Flash）
# TUTOR_FIRST_TOKEN_TIMEOUT_MS=15000 # 仅无首字阶段；超时后自动切已配置备用 provider（范围 5000-45000）
# VISION_MODEL=     # 多模态/视觉（留空回落注册表第一个多模态模型）
# LLM_BASE_URL=     # 仅 Qwen/DashScope 自定义网关时设置

# Document parsing (pdf/docx) via DashScope file extraction + qwen-doc
# DASHSCOPE_DOC_BASE_URL defaults to LLM_BASE_URL
# DASHSCOPE_DOC_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# DASHSCOPE_DOC_MODEL=qwen-doc-turbo
# DASHSCOPE_DOC_TIMEOUT_MS=180000
# DASHSCOPE_DOC_RETRIES=2
# DASHSCOPE_DOC_MAX_TOKENS=12000
# DASHSCOPE_DOC_FILE_READY_MAX_WAIT_MS=120000
# DASHSCOPE_DOC_FILE_READY_POLL_MS=1500
# INGEST_MAX_FILE_MB=100          # 上传文件大小上限（默认 100MB，下游 DashScope 支持 150MB）
# INGEST_MIN_EXTRACTED_CHARS=50   # 文档提取低于该字数视为失败（防扫描件 PDF 静默假成功）

# Realtime ASR
# 新一代 Qwen-Audio-3.0-ASR / Fun-ASR 模型族（duplex 任务协议）；改回 qwen3-asr-* 即走旧协议，无需改代码
DASHSCOPE_ASR_WS_MODEL=qwen-audio-3.0-asr-flash-streaming
DASHSCOPE_ASR_BATCH_MODEL=qwen-audio-3.0-asr-flash
DASHSCOPE_ASR_FILE_MODEL=qwen-audio-3.0-asr-flash-filetrans
# 实时上游地址：默认按模型族自动选择（新族 /api-ws/v1/inference，旧族 /api-ws/v1/realtime）；
# 可整体覆盖，例如 WorkspaceId 专属域名 wss://{WorkspaceId}.cn-beijing.maas.aliyuncs.com/api-ws/v1/inference
# DASHSCOPE_ASR_WS_URL=
DASHSCOPE_ASR_WS_SR=16000
# 新族映射为 max_sentence_silence（VAD 断句静音阈值，[200,6000]）；旧族为 turn_detection.silence_duration_ms
DASHSCOPE_ASR_WS_VAD_SILENCE_MS=1000
# 仅旧族（qwen3-asr realtime turn_detection.threshold）生效；新族协议无对应参数，会被忽略。
# 课堂远场 / 手机麦克风优先接住软声；越高越不易被环境声触发，但会增加吞段风险。
DASHSCOPE_ASR_WS_VAD_THRESHOLD=0.20
ASR_DRAFT_FLUSH_MS=800
ASR_DEDUP_SIMILARITY=0.95
ASR_DEDUP_GAP_MS=1500

# Speaker Diarization (录音后说话人分离)
# 默认 qwen-audio-3.0-asr-flash-filetrans（新一代，原生说话人分离）+ diarization_enabled: true
# 2026-08 单遍化：不再自动触发；/api/asr/diarize 保留可用，供将来的手动「重新精转」
# DASHSCOPE_DIARIZATION_MODEL=qwen-audio-3.0-asr-flash-filetrans

# ===== 实时语音同桌 / 「聊聊你想要的」打电话模式（2026-08 已下线）=====
# 决策：实时语音通话整体下线，server.js 的 /api/tutor-call WebSocket 代理已拆除。
# 以下 DASHSCOPE_OMNI_REALTIME_* / DASHSCOPE_OMNI_TURN_DETECTION 等 key 已无任何代码读取，
# 保留本说明一个周期，之后物理删除。
# DASHSCOPE_OMNI_REALTIME_MODEL=qwen3.5-omni-plus-realtime
# DASHSCOPE_OMNI_REALTIME_TRANSCRIPT_MODEL=gummy-realtime-v1
# DASHSCOPE_OMNI_REALTIME_VOICE=Ethan
# DASHSCOPE_OMNI_TURN_DETECTION=semantic_vad
# DASHSCOPE_OMNI_NOISE_REDUCTION=near_field
# DASHSCOPE_OMNI_SILENCE_DURATION_MS=1500
# DASHSCOPE_OMNI_VAD_THRESHOLD=0.5

# Subdomain deployment example
# PORT=3002

# Public base URL for offline ASR/media callbacks (required in deployed env)
# PUBLIC_DOMAIN=capture.meetmind.online
# PUBLIC_HOST=capture.meetmind.online
# PUBLIC_PROTOCOL=https

# Transcript post-correction
TRANSCRIPT_CORRECTION_MODE=layered
TRANSCRIPT_LIGHT_MODEL=qwen-turbo
TRANSCRIPT_FALLBACK_MODEL=qwen-plus
TRANSCRIPT_ENABLE_MAX_FALLBACK=false

# ASR LLM 后校对（2026-08 单遍化后接管文本纠错，仅作用于 /api/transcribe-fast 精转链路）
# 默认开启；模型 DeepSeek V4 Flash（用上面 DeepSeek 段的 DEEPSEEK_API_KEY / DEEPSEEK_BASE_URL），
# 只对低置信/可疑片段按节分批复核（单批 ≤10 条且 ≤6000 字符，最多 5 批），失败静默降级原文。
# ASR_POST_EDIT_ENABLED=false   # 设为 false 关闭
# ASR_POST_EDIT_BATCH_CHAR_LIMIT=6000

# ===== Volcengine Ark (optional) =====
# VOLCENGINE_ARK_API_KEY=your-ark-api-key
# VOLCENGINE_ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
# VOLCENGINE_ARK_MODEL=your-ark-model-or-endpoint-id

# ===== Relay Gateway (optional) =====
# RELAY_API_KEY=your-relay-api-key
# RELAY_BASE_URL=https://your-relay-host/v1
# Moonshot Kimi（导演模型：板书节奏标注 pass——给 BoardScript 全量 cue + 段后呼吸 breathMs）。
# kimi-k3 直接走百炼（复用 DASHSCOPE_API_KEY；注意百炼上 id 带命名空间前缀：kimi/kimi-k3，裸 id 会 access_denied）。
# K3 已默认承担：拍题一体（BOARD_PHOTO_ONESHOT_MODEL）+ 课堂生成（BOARD_EXPLAINER_MODEL）+ 导演（BOARD_DIRECTOR_MODEL）。
# MOONSHOT_* 为备选直连通道；延迟敏感场景可换 kimi/kimi-k2.7-code-highspeed 或 DeepSeek-V4-Flash。
# MOONSHOT_API_KEY=sk-...
# MOONSHOT_BASE_URL=https://api.moonshot.cn/v1
# MOONSHOT_MODEL=kimi-k3
# BOARD_DIRECTOR_MODEL=kimi/kimi-k3
# BOARD_EXPLAINER_MODEL=kimi/kimi-k3
# 拍题实时链路默认 qwen3.7-plus（38s）；K3 质量更好但 7 分钟/份，需要时手动开
# BOARD_PHOTO_ONESHOT_MODEL=qwen3.7-plus
# K3 思考链较长（生成一份板书脚本 2-5 分钟），HTTP 超时需上调（默认 180s 会 502；上限 600s）
# LLM_HTTP_TIMEOUT_MS=600000
# RELAY_MODEL=gemini-3-pro-image-preview

# ===== CommonStack Echo (optional but required for daily echo) =====
# Used by the daily "回声" feature.
# COMMONSTACK_ECHO_API_KEY=your-commonstack-api-key
# COMMONSTACK_ECHO_BASE_URL=https://api.commonstack.ai/v1
# COMMONSTACK_ECHO_MODEL=google/gemini-3-flash-preview
# COMMONSTACK_ECHO_TEMPERATURE=0.2
# ENABLE_ECHO_MANUAL_TRIGGER=true
# NEXT_PUBLIC_ENABLE_ECHO_MANUAL_TRIGGER=true

# ===== Teach（AI 家教「上课」线，codex app-server 底座）=====
# 架构：浏览器 ←SSE→ /api/teach/* ←JSON-RPC→ codex app-server ←MCP stdio→ 板书工具
#       codex 经本地 shim（Responses→Chat 翻译，127.0.0.1）调上游 chat 模型。
# 底座模型 provider（一行切换）：
#   gemini-commonstack（默认）：Gemini 3.7 Flash 经 commonstack，复用上面 COMMONSTACK_ECHO_*；
#     模型 id google/gemini-3.7-flash。注意 TTFT 4–30s 抖动（见 out/codex-spike/REPORT.md）。
#   glm-dashscope（备选）：百炼 GLM-5.3（id ZHIPU/GLM-5.3），复用 DASHSCOPE_API_KEY。
#   gemini-openai-next：Gemini 3.7 Flash 经 OpenAI Next 中转（id gemini-3.7-flash），
#     shim 自动注入 reasoning_effort=low 压 TTFT（该网关 reasoning 占比 70%+）。
# OPENAI_NEXT_API_KEY=your-openai-next-api-key
# OPENAI_NEXT_BASE_URL=https://api.openai-next.com/v1
# TEACH_PROVIDER=gemini-commonstack
# TEACH_MODEL=google/gemini-3.7-flash   # 覆盖当前 provider 的模型 id（一般不用改）
# TEACH_SHIM_PORT=8799                  # shim 常驻端口（仅 127.0.0.1；被占用则复用健康实例）
# TEACH_IDLE_MS=900000                  # codex 进程空闲回收阈值（默认 15 分钟）
# TEACH_CODEX_BIN=                      # codex 二进制路径（默认 node_modules/.bin/codex）
# TEACH_CODEX_HOME=data/teach-codex     # CODEX_HOME 根（按线程隔离子目录，不污染 ~/.codex）
# TEACH_EVENT_LOG_DIR=data/teach-events # 每线程事件日志（<threadId>.jsonl，供重放/复习线）
# TEACH_INTERNAL_BASE_URL=              # MCP→Next 内部回调地址（默认 http://127.0.0.1:$PORT）
# 讲课声音 TTS（/api/teach/tts，按句合成；复用 DASHSCOPE_API_KEY；选型见 out/tts-spike/REPORT.md）：
#   qwen-instruct-flash（默认）：qwen3-tts-instruct-flash + Cherry + 教学语气指令。
#   备选 MiniMax speech-2.8（百炼渠道，控制台开通后在 teach-tts-service.ts 补实现即可切换）。
# TEACH_TTS_PROVIDER=qwen-instruct-flash
# TEACH_TTS_MODEL=qwen3-tts-instruct-flash
# TEACH_TTS_VOICE=Cherry
# TEACH_TTS_INSTRUCT=你正在进行课堂教学，说话自然流畅，提问时语气上扬   # 显式空串关闭指令
# TEACH_TTS_CACHE_DIR=data/teach-tts-cache  # 内容寻址磁盘缓存（200 条 FIFO）

# ===== 「请一个分身」线（nuwa skill × codex harness，/api/fenshen/*）=====
# 蒸馏线程固定 GLM（Gemini 3 的 thought_signature 与带工具线程不兼容，见 out/fenshen-spike/REPORT.md）；
# 对话线程跟随 TEACH_PROVIDER。名人轨联网语料采集走 Firecrawl 官方远端 MCP（需 FIRECRAWL_API_KEY，见上文）。
# FENSHEN_DISTILL_PROVIDER=gemini-openai-next  # 蒸馏线程 provider（teach 注册表内的 id；默认 openai-next，已实测完整蒸馏跑通）
# FENSHEN_CODEX_HOME=data/fenshen-codex    # 分身数据根（<egoId>/{distill-home,chat-home,work}）
# FENSHEN_EVENT_LOG_DIR=data/fenshen-events # 每分身事件日志（<egoId>.jsonl，供重放）
# FENSHEN_NUWA_TEMPLATE_DIR=assets/fenshen/huashu-nuwa  # nuwa skill 原文模板源
# FENSHEN_ASR_MAX_WAIT_MS=1800000          # 私有轨 B站/上传长音频 filetrans 轮询上限（默认 30 分钟）
# FENSHEN_UPLOAD_AUDIO_DIR=                # upload 轨音频查找目录（默认 public/temp-audio）


# ===== Volcengine Podcast (optional) =====
# VOLCENGINE_PODCAST_APP_ID=your-app-id
# X-Api-Access-Key should use your Volcengine console Access Token
# VOLCENGINE_PODCAST_ACCESS_TOKEN=your-access-token
# VOLCENGINE_PODCAST_SECRET_KEY=your-secret-key
# VOLCENGINE_PODCAST_RESOURCE_ID=volc.service_type.10050
# VOLCENGINE_PODCAST_APP_KEY=aGjiRDfUWi

# ===== Firecrawl（网页文章提取，可绕过微信公众号反爬）=====
# 免费版 500 credits/月，提取一篇文章约 1 credit。
# 配置后作为所有平台文章提取的首选策略；不配置则回落到 OpenClaw / Jina / 本地 fetch。
# FIRECRAWL_API_KEY=fc-your-key-here

# ===== OpenClaw Gateway（微信公众号文章爬取，即将弃用）=====
# 已deprecated：Firecrawl 可提供更稳定的微信文章提取，无需额外 Gateway 服务器。
# 保留作为 fallback，直到 Firecrawl 完全验证稳定后移除。
# OPENCLAW_GATEWAY_URL=https://directly-chosen-scrunch.ngrok-free.dev/v1/chat/completions
# OPENCLAW_TOKEN=dc0d48dca00d7645611ba3cd13324fecadf740eb021c6c73

# ===== OpenBiliClaw 信息流后端（M15 Phase 2，可选）=====
# 本地部署的 OpenBiliClaw 后端地址。在线时信息流 tab 追加 B站视频推荐。
# 不配置时默认 http://127.0.0.1:8420；OpenBiliClaw 离线时降级到 MeetMind 自带信息流。
# OPENBILICLAW_API_URL=http://127.0.0.1:8420

# Optional external services
# NEXT_PUBLIC_NOTEBOOK_API=http://localhost:5055
# ENABLE_NOTEBOOK=true

# ===== WeChat login + Official Account capture (optional) =====
# Enables: desktop temporary-parameter QR login/binding + in-WeChat OAuth login.
# The AppID/secret must belong to the same verified Official Account that sends callbacks to /api/wechat/mp.
# NEXT_PUBLIC_ENABLE_WECHAT_LOGIN=true
# WECHAT_APP_ID=your-official-account-app-id
# WECHAT_APP_SECRET=your-official-account-app-secret
# WECHAT_REDIRECT_URI=https://capture.meetmind.online/api/auth/wechat/callback
# Callback verification token. Required for both QR subscribe/SCAN events and capture messages.
# WECHAT_MP_TOKEN=your-official-account-callback-token
# Public H5 base used in capture replies.
# WECHAT_MP_PUBLIC_BASE_URL=https://capture.meetmind.online

# ===== WeChat Pay（积分充值 Native 扫码，optional）=====
# 全部在「微信支付商户平台」(pay.weixin.qq.com) 获取：账户中心/API 安全。
# 六项齐全才启用充值；缺任意一项 /api/pay/recharge 返回 503 pay_unavailable。
# 商户号（账户中心 → 个人信息）
# WECHAT_PAY_MCHID=1230000109
# 关联的公众号 AppID（须与上方 WECHAT_APP_ID 同一主体，下单必带）
# WECHAT_PAY_APPID=your-official-account-app-id
# APIv3 密钥（API 安全 → APIv3 密钥，32 字节，回调 AES-256-GCM 解密用）
# WECHAT_PAY_APIV3_KEY=your-apiv3-key
# 商户证书序列号（API 安全 → API 证书）
# WECHAT_PAY_SERIAL_NO=your-merchant-cert-serial-no
# 商户 API 私钥 PEM（apiclient_key.pem 内容；单行书写时换行用 \n 字面量）
# WECHAT_PAY_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
# 微信支付平台证书 PEM（API 安全 → 微信支付平台证书，手动下载；到期轮换时更新此值）
# WECHAT_PAY_PLATFORM_CERT_PEM="-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----"
# 支付回调地址（缺省用 WECHAT_MP_PUBLIC_BASE_URL + /api/wechat/pay-notify）
# WECHAT_PAY_NOTIFY_URL=https://capture.meetmind.online/api/wechat/pay-notify

# ===== Frontend ASR tuning (optional) =====
# NEXT_PUBLIC_ASR_DEDUP_SIMILARITY=0.95
# NEXT_PUBLIC_ASR_DEDUP_GAP_MS=1500
# NEXT_PUBLIC_ASR_AUTO_GAIN_CONTROL=true
# NEXT_PUBLIC_ASR_ECHO_CANCELLATION=false
# NEXT_PUBLIC_ASR_NOISE_SUPPRESSION=true
# NEXT_PUBLIC_TRANSCRIPT_LIGHT_MODEL=qwen-turbo
# NEXT_PUBLIC_TRANSCRIPT_FALLBACK_MODEL=qwen-plus

# ===== Observability (Sentry) =====
# Leave empty to disable Sentry; pino structured logging still works without DSN.
# SENTRY_DSN=https://example@o0.ingest.sentry.io/0
# NEXT_PUBLIC_SENTRY_DSN=https://example@o0.ingest.sentry.io/0
# SENTRY_ENV=development
# SENTRY_RELEASE=
# SENTRY_TRACES_SAMPLE_RATE=0.2                  # server: prod 0.2 / dev 1.0
# NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0.1      # client: prod 0.1 / dev 1.0
# SENTRY_AI_RECORD_INPUTS=false                  # 禁用默认；合规审计时再开
# SENTRY_AI_RECORD_OUTPUTS=false

# ===== Structured logs =====
# LOG_LEVEL=info      # debug / info / warn / error
# LOG_JSON=true       # force JSON output in dev (default: pretty)

# ===== B站 / 视频导入 =====
# B站导入需要 Cookie 才能稳定拉取音频/字幕。匿名请求大概率被 -352 风控拦截。
# 用户可在「设置 → 视频导入」配置自己的 Cookie（前端自动传给后端）；
# 以下是服务器全局兜底 Cookie（用于未登录用户或全局优先）。
# BILIBILI_COOKIE=SESSDATA=xxx; bili_jct=xxx; DedeUserID=xxx
# 策略：bili-native-first（自研 API 优先）或 yt-dlp-first
# VIDEO_IMPORT_STRATEGY=bili-native-first
# VIDEO_IMPORT_ENABLE_YTDLP_FALLBACK=true
# yt-dlp 二进制路径（默认从 PATH 查找）
# YT_DLP_BIN=yt-dlp
# 超时/重试（毫秒）
# BILI_FETCH_TIMEOUT_MS=12000
# BILI_FETCH_MAX_RETRIES=2
# BILI_AUDIO_DOWNLOAD_TIMEOUT_MS=600000

# ===== 清小搭广场接入（OpenAI 兼容适配层 /api/compat/v1，optional）=====
# 清小搭广场接入凭证，Bearer 校验用。平台网关调用 {baseUrl}/models 与
# {baseUrl}/chat/completions 时携带 `Authorization: Bearer <此值>`。
# 未配置时适配层整体停用：两个端点均返回 503 service_disabled。
# XIAODA_API_KEY=replace-with-xiaoda-credential
# 每日成本闸（进程内计数，UTC 跨天清零）：chat 请求数上限（默认 500）、
# 音频转写次数上限（默认 100）。超闸返回 429 daily_cap_exceeded。
# XIAODA_DAILY_CHAT_CAP=500
# XIAODA_DAILY_AUDIO_CAP=100

# ===== Smoke / e2e 测试绕过限流 =====
# 仅当此 env 已设且请求 header X-Smoke-Bypass 匹配时，applyRateLimit 直接放行。
# 用于 make smoke / make smoke-intent 等真实端到端测试，避免被项目自有 rate-limiter 阻挡。
# **线上请勿配置**。本地按需开启即可。
# SMOKE_BYPASS_TOKEN=
