                "text": "一、知识回顾",
                "role": "term"
              },
              {
                "type": "write",
                "text": "一般式（General Form）",
                "role": "step"
              },
              {
                "type": "write",
                "text": "ax^2+bx+c=0\\quad(a\\neq 0)",
                "role": "formula"
              },
              {
                "type": "write",
                "text": "==a≠0==，否则退化成一次方程",
                "role": "note"
              },
              {
                "type": "write",
                "text": "热身：配方法解 x²+6x+5=0",
                "role": "step"
              },
              {
                "type": "write",
                "text": "① 移项：常数移到右边",
                "role": "step"
              },
              {
                "type": "write",
                "text": "x^2+6x=-5",
                "role": "formula"
              },
              {
                "type": "write",
                "text": "② 配方：两边同加 (6/2)²",
                "role": "step"
              },
              {
                "type": "write",
                "text": "x^2+6x+9=-5+9",
                "role": "formula"
              },
              {
                "type": "write",
                "text": "③ 写成完全平方",
                "role": "step"
              },
              {
                "type": "write",
                "text": "(x+3)^2=4",
                "role": "formula"
              }
            ]
          },
