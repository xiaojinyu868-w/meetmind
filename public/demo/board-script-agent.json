              {
                "type": "write",
                "text": "二、配方法推导求根公式",
                "role": "term"
              },
              {
                "type": "write",
                "text": "ax^2+bx+c=0\\quad(a\\neq 0)",
                "role": "formula"
              },
              {
                "type": "write",
                "text": "第1步：==两边同除 a==",
                "role": "step"
              },
              {
                "type": "write",
                "text": "把 x² 系数化为 1，才好配方",
                "role": "note"
              },
              {
                "type": "write",
                "text": "x^2+\\frac{b}{a}x+\\frac{c}{a}=0",
                "role": "formula"
              },
              {
                "type": "write",
                "text": "第2步：移项",
                "role": "step"
              },
              {
                "type": "write",
                "text": "x^2+\\frac{b}{a}x=-\\frac{c}{a}",
                "role": "formula"
              },
              {
                "type": "write",
                "text": "第3步：==配方==",
                "role": "step"
              },
              {
                "type": "write",
                "text": "一次项系数一半：(b/a)/2 = b/(2a)",
                "role": "note"
              },
              {
                "type": "write",
                "text": "两边同加它的平方：",
                "role": "step"
              },
              {
                "type": "write",
                "text": "x^2+\\frac{b}{a}x+\\left(\\frac{b}{2a}\\right)^2=-\\frac{c}{a}+\\left(\\frac{b}{2a}\\right)^2",
                "role": "formula"
              },
              {
                "type": "write",
                "text": "第4步：左边合成完全平方",
                "role": "step"
              },
              {
                "type": "write",
                "text": "\\left(x+\\frac{b}{2a}\\right)^2=\\frac{b^2-4ac}{4a^2}",
                "role": "formula"
              },
              {
                "type": "pause",
