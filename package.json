{
  "name": "meetmind",
  "version": "1.0.0",
  "description": "MeetMind MVP - 课堂对齐的 AI 家教（依赖 Open Notebook + Discussion + LongCut）",
  "private": true,
  "scripts": {
    "dev": "node server.js",
    "dev:clean": "npm run clean:next && node server.js",
    "dev:next": "next dev -p 3001",
    "clean:next": "node -e \"const fs=require('fs');const dirs=['.next',...fs.readdirSync('.').filter((name)=>name==='.next-dev'||name.startsWith('.next-dev-'))];for(const dir of dirs){try{fs.rmSync(dir,{recursive:true,force:true});console.log('cleaned',dir)}catch(e){console.log('skip clean',dir,e?.message||e)}}\"",
    "prisma:generate": "prisma generate",
    "prebuild": "node scripts/prebuild.js",
    "build": "next build",
    "start": "NODE_ENV=production node server.js",
    "start:next": "next start -p 3001",
    "lint": "next lint",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify:podcast": "node scripts/verify-volc-podcast.js",
    "e2": "playwright test",
    "e2e": "playwright test",
    "e2e:headed": "playwright test --headed",
    "e2e:ui": "playwright test --ui"
  },
  "dependencies": {
