// Prisma Schema for MeetMind
// 使用 SQLite 作为内测数据库，后续可轻松迁移到 MySQL/PostgreSQL

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

// 用户表
model User {
  id           String   @id @default(cuid())
  username     String   @unique
  email        String?  @unique
  phone        String?  @unique
  nickname     String
  avatar       String?
  role         String   @default("student") // student, parent, teacher, admin
  status       String   @default("active")  // active, inactive, suspended, pending
  passwordHash String?
  salt         String?
  defaultWorkspaceId String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  lastLoginAt  DateTime?

  // 关联
  defaultWorkspace Workspace? @relation("DefaultWorkspaceSelection", fields: [defaultWorkspaceId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  authProviders AuthProvider[]
  sessions      Session[]
  refreshTokens RefreshToken[]
  ownedWorkspaces Workspace[] @relation("WorkspaceOwner")
  workspaceMemberships WorkspaceMembership[]
  workspaceCaptures WorkspaceCapture[]
  wechatInboxMessages WechatInboxMessage[]

  @@index([username])
  @@index([email])
  @@index([phone])
  @@index([defaultWorkspaceId])
}

// 第三方登录关联表
model AuthProvider {
  id           String   @id @default(cuid())
  userId       String
  provider     String   // local, wechat, google, apple
  providerId   String   // 第三方平台的用户ID
  accessToken  String?
  refreshToken String?
  expiresAt    DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerId])
  @@index([userId])
}

// 用户会话表
model Workspace {
  id        String   @id @default(cuid())
  name      String
  slug      String?  @unique
  kind      String   @default("personal")
  status    String   @default("active")
  ownerId   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  owner User @relation("WorkspaceOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  defaultForUsers User[] @relation("DefaultWorkspaceSelection")
  members WorkspaceMembership[]
  captures WorkspaceCapture[]
  echoes WorkspaceEcho[]
  wechatInboxMessages WechatInboxMessage[]

  @@index([ownerId])
  @@index([kind])
  @@index([status])
}

model WorkspaceMembership {
  id          String   @id @default(cuid())
  workspaceId String
  userId      String
  role        String   @default("owner")
  status      String   @default("active")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@index([userId])
  @@index([workspaceId])
  @@index([role])
}

model WorkspaceCapture {
  id             String   @id @default(cuid())
  workspaceId    String
  userId         String?
  sourceType     String
  sourceKey      String   @unique
  role           String   @default("support")
  contentType    String
  title          String
  previewText    String?
  normalizedText String?
  sourceUrl      String?
  mediaUrl       String?
  metadataJson   String?
  tutorContext   String?
  occurredAt     DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  echoes    WorkspaceEcho[]

  @@index([workspaceId])
  @@index([userId])
  @@index([role])
  @@index([contentType])
  @@index([createdAt])
}

model WorkspaceEcho {
  id          String   @id @default(cuid())
  workspaceId String
  captureId   String?
  sourceKey   String   @unique
  kind        String?
  generatedDateKey String?
  model       String?
  promptVersion String?
  title       String
  body        String
  chipsJson   String?
  metadataJson String?
  status      String   @default("active")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  capture   WorkspaceCapture? @relation(fields: [captureId], references: [id], onDelete: SetNull)

  @@index([workspaceId])
  @@index([captureId])
  @@index([kind])
  @@index([status])
  @@index([generatedDateKey])
  @@index([workspaceId, kind, generatedDateKey])
  @@index([createdAt])
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  userAgent String?
  ip        String?
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
}

// 刷新令牌表
model RefreshToken {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
}

// 登录限流记录表
model LoginAttempt {
  id           String   @id @default(cuid())
  identifier   String   // 用户名/邮箱/手机号/IP
  count        Int      @default(1)
  firstAttempt DateTime @default(now())
  lockedUntil  DateTime?

  @@unique([identifier])
}

// CSRF Token 表
model CsrfToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String?
  createdAt DateTime @default(now())

  @@index([token])
}

// 验证码表（邮箱/短信通用）
model VerificationCode {
  id         String   @id @default(cuid())
  target     String   // 邮箱或手机号
  code       String   // 6位验证码
  type       String   // email, sms
  purpose    String   // login, register, reset_password
  attempts   Int      @default(0) // 验证尝试次数
  verified   Boolean  @default(false)
  expiresAt  DateTime
  createdAt  DateTime @default(now())

  @@index([target, type, purpose])
  @@index([code])
}

// 用户反馈表
model Feedback {
  id        String   @id @default(cuid())
  type      String   // bug, feature, question, other
  title     String
  content   String
  contact   String?  // 用户提供的联系方式
  userId    String?  // 登录用户的ID（可选）
  userAgent String?
  ip        String?
  status    String   @default("pending") // pending, processing, resolved, closed
  adminNote String?  // 管理员备注
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([type])
  @@index([status])
  @@index([userId])
}

// ==================== API 使用记录模型 ====================

// API 使用统计表 - 记录用户 API 调用配额
model ApiUsage {
  id        String   @id @default(cuid())
  userId    String   // 用户ID（可以是 guest_xxx 表示访客）
  quotaType String   // 配额类型：transcribe, ai_summary, ai_topics, ai_tutor, ai_chat
  date      DateTime // 统计日期（精确到天）
  count     Int      @default(0) // 使用次数
  metadata  String?  // 额外元数据（JSON）
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, quotaType, date], name: "userId_quotaType_date")
  @@index([userId])
  @@index([quotaType])
  @@index([date])
}

// ==================== 数据分析模型 ====================

// 用户分析会话表 - 记录每次用户访问的完整会话
model UserAnalytics {
  id           String    @id @default(cuid())
  userId       String?   // 可选，支持匿名用户追踪
  sessionToken String    @unique // 客户端生成的会话标识
  ip           String?   // 用户IP地址
  userAgent    String?   // 浏览器/设备信息
  entryPage    String?   // 入口页面
  exitPage     String?   // 退出页面
  startedAt    DateTime  @default(now()) // 会话开始时间
  endedAt      DateTime? // 会话结束时间
  durationMs   Int       @default(0) // 总时长（毫秒）
  isNewUser    Boolean   @default(false) // 是否新用户首次访问

  // 关联
  pageViews PageView[]
  events    EventTrack[]

  @@index([userId])
  @@index([startedAt])
  @@index([ip])
  @@index([isNewUser])
}

// 页面访问记录表 - 记录用户访问的每个页面
model PageView {
  id          String   @id @default(cuid())
  analyticsId String   // 关联的会话ID
  path        String   // 页面路径
  visitedAt   DateTime @default(now()) // 访问时间
  durationMs  Int      @default(0) // 页面停留时长（毫秒）
  referrer    String?  // 来源页面

  analytics UserAnalytics @relation(fields: [analyticsId], references: [id], onDelete: Cascade)

  @@index([analyticsId])
  @@index([path])
  @@index([visitedAt])
}

// 事件追踪表 - 记录用户的关键交互行为
model EventTrack {
  id            String   @id @default(cuid())
  analyticsId   String   // 关联的会话ID
  eventName     String   // 事件名称（如 recording_start, anchor_mark）
  eventCategory String?  // 事件分类（如 recording, learning, ai）
  eventData     String?  // 额外数据（JSON格式）
  createdAt     DateTime @default(now())

  analytics UserAnalytics @relation(fields: [analyticsId], references: [id], onDelete: Cascade)

  @@index([analyticsId])
  @@index([eventName])
  @@index([eventCategory])
  @@index([createdAt])
}

model WechatInboxMessage {
  id             String   @id @default(cuid())
  linkToken      String   @unique
  openId         String
  userId         String?
  workspaceId    String?
  developerId    String?
  msgType        String
  eventType      String?
  messageId      String?  @unique
  messageAt      DateTime?
  rawXml         String
  payloadJson    String
  normalizedText String?
  previewText    String?
  sourceUrl      String?
  mediaId        String?
  mediaUrl       String?
  title          String?
  reachKind      String?
  reachChannel   String?
  collectionRole String?
  bindingStatus  String   @default("unresolved")
  echoTitle      String?
  echoBody       String?
  echoChipsJson  String?
  tutorContext   String?
  replyText      String?
  processedAt    DateTime?
  status         String   @default("received")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user      User?      @relation(fields: [userId], references: [id], onDelete: SetNull)
  workspace Workspace? @relation(fields: [workspaceId], references: [id], onDelete: SetNull)

  @@index([openId])
  @@index([userId])
  @@index([workspaceId])
  @@index([msgType])
  @@index([eventType])
  @@index([bindingStatus])
  @@index([reachChannel])
  @@index([createdAt])
}
