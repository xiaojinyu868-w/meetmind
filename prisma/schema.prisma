// Prisma Schema for MeetMind
// 使用 SQLite 作为内测数据库，后续可轻松迁移到 MySQL/PostgreSQL

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

// 用户表
model User {
  id                    String    @id @default(cuid())
  username              String    @unique
  email                 String?   @unique
  phone                 String?   @unique
  nickname              String
  avatar                String?
  role                  String    @default("student") // student, parent, teacher, admin
  status                String    @default("active") // active, inactive, suspended, pending
  passwordHash          String?
  salt                  String?
  defaultWorkspaceId    String?
  learnerProfileJson    String? // JSON — 学习者画像（身份阶段+专业+年级等）
  onboardingCompletedAt DateTime? // null = 未完成 onboarding
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  lastLoginAt           DateTime?

  // 关联
  defaultWorkspace     Workspace?            @relation("DefaultWorkspaceSelection", fields: [defaultWorkspaceId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  authProviders        AuthProvider[]
  sessions             Session[]
  refreshTokens        RefreshToken[]
  ownedWorkspaces      Workspace[]           @relation("WorkspaceOwner")
  workspaceMemberships WorkspaceMembership[]
  workspaceCaptures    WorkspaceCapture[]
  wechatInboxMessages  WechatInboxMessage[]
  asrCorrections       AsrCorrection[]
  asrHotwords          AsrHotword[]
  sharedAgentsOwned    SharedAgent[]         @relation("SharedAgentOwner")
  shareClaims          ShareClaim[]          @relation("ShareClaimer")
  shareInteractions    ShareInteraction[]    @relation("ShareInteractionVisitor")
  agentPacks           AgentPack[]           @relation("UserAgentPacks")

  @@index([username])
  @@index([email])
  @@index([phone])
  @@index([defaultWorkspaceId])
}

// 第三方登录关联表
model AuthProvider {
  id           String    @id @default(cuid())
  userId       String
  provider     String // local, wechat, google, apple
  providerId   String // 第三方平台的用户ID
  accessToken  String?
  refreshToken String?
  expiresAt    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerId])
  @@index([userId])
}

// 用户会话表
model Workspace {
  id        String   @id @default(cuid())
  name      String
  slug      String?  @unique
  kind      String   @default("personal")
  status    String   @default("active")
  ownerId   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  owner               User                  @relation("WorkspaceOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  defaultForUsers     User[]                @relation("DefaultWorkspaceSelection")
  members             WorkspaceMembership[]
  captures            WorkspaceCapture[]
  echoes              WorkspaceEcho[]
  wechatInboxMessages WechatInboxMessage[]
  asrCorrections      AsrCorrection[]
  asrHotwords         AsrHotword[]
  sharedAgents        SharedAgent[]         @relation("SharedAgentWorkspace")

  @@index([ownerId])
  @@index([kind])
  @@index([status])
}

model WorkspaceMembership {
  id          String   @id @default(cuid())
  workspaceId String
  userId      String
  role        String   @default("owner")
  status      String   @default("active")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@index([userId])
  @@index([workspaceId])
  @@index([role])
}

model WorkspaceCapture {
  id             String    @id @default(cuid())
  workspaceId    String
  userId         String?
  sourceType     String
  sourceKey      String    @unique
  status         String    @default("active")
  role           String    @default("support")
  contentType    String
  title          String
  previewText    String?
  normalizedText String?
  sourceUrl      String?
  mediaUrl       String?
  metadataJson   String?
  tutorContext   String?
  occurredAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  workspace Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User?           @relation(fields: [userId], references: [id], onDelete: SetNull)
  echoes    WorkspaceEcho[]

  @@index([workspaceId])
  @@index([workspaceId, status])
  @@index([userId])
  @@index([status])
  @@index([role])
  @@index([contentType])
  @@index([createdAt])
}

model WorkspaceEcho {
  id               String   @id @default(cuid())
  workspaceId      String
  captureId        String?
  sourceKey        String   @unique
  kind             String?
  generatedDateKey String?
  model            String?
  promptVersion    String?
  title            String
  body             String
  chipsJson        String?
  metadataJson     String?
  status           String   @default("active")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  workspace Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  capture   WorkspaceCapture? @relation(fields: [captureId], references: [id], onDelete: SetNull)

  @@index([workspaceId])
  @@index([captureId])
  @@index([kind])
  @@index([status])
  @@index([generatedDateKey])
  @@index([workspaceId, kind, generatedDateKey])
  @@index([createdAt])
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  userAgent String?
  ip        String?
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
}

// 刷新令牌表
model RefreshToken {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
}

// 登录限流记录表
model LoginAttempt {
  id           String    @id @default(cuid())
  identifier   String // 用户名/邮箱/手机号/IP
  count        Int       @default(1)
  firstAttempt DateTime  @default(now())
  lockedUntil  DateTime?

  @@unique([identifier])
}

// CSRF Token 表
model CsrfToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String?
  createdAt DateTime @default(now())

  @@index([token])
}

// 验证码表（邮箱/短信通用）
model VerificationCode {
  id        String   @id @default(cuid())
  target    String // 邮箱或手机号
  code      String // 6位验证码
  type      String // email, sms
  purpose   String // login, register, reset_password
  attempts  Int      @default(0) // 验证尝试次数
  verified  Boolean  @default(false)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([target, type, purpose])
  @@index([code])
}

// 用户反馈表
model Feedback {
  id        String   @id @default(cuid())
  type      String // bug, feature, question, other
  title     String
  content   String
  contact   String? // 用户提供的联系方式
  userId    String? // 登录用户的ID（可选）
  userAgent String?
  ip        String?
  status    String   @default("pending") // pending, processing, resolved, closed
  adminNote String? // 管理员备注
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([type])
  @@index([status])
  @@index([userId])
}

// ==================== API 使用记录模型 ====================

// API 使用统计表 - 记录用户 API 调用配额
model ApiUsage {
  id        String   @id @default(cuid())
  userId    String // 用户ID（可以是 guest_xxx 表示访客）
  quotaType String // 配额类型：transcribe, ai_summary, ai_topics, ai_tutor, ai_chat
  date      DateTime // 统计日期（精确到天）
  count     Int      @default(0) // 使用次数
  metadata  String? // 额外元数据（JSON）
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, quotaType, date], name: "userId_quotaType_date")
  @@index([userId])
  @@index([quotaType])
  @@index([date])
}

// ==================== 数据分析模型 ====================

// 用户分析会话表 - 记录每次用户访问的完整会话
model UserAnalytics {
  id           String    @id @default(cuid())
  userId       String? // 可选，支持匿名用户追踪
  sessionToken String    @unique // 客户端生成的会话标识
  ip           String? // 用户IP地址
  userAgent    String? // 浏览器/设备信息
  entryPage    String? // 入口页面
  exitPage     String? // 退出页面
  startedAt    DateTime  @default(now()) // 会话开始时间
  endedAt      DateTime? // 会话结束时间
  durationMs   Int       @default(0) // 总时长（毫秒）
  isNewUser    Boolean   @default(false) // 是否新用户首次访问

  // 关联
  pageViews PageView[]
  events    EventTrack[]

  @@index([userId])
  @@index([startedAt])
  @@index([ip])
  @@index([isNewUser])
}

// 页面访问记录表 - 记录用户访问的每个页面
model PageView {
  id          String   @id @default(cuid())
  analyticsId String // 关联的会话ID
  path        String // 页面路径
  visitedAt   DateTime @default(now()) // 访问时间
  durationMs  Int      @default(0) // 页面停留时长（毫秒）
  referrer    String? // 来源页面

  analytics UserAnalytics @relation(fields: [analyticsId], references: [id], onDelete: Cascade)

  @@index([analyticsId])
  @@index([path])
  @@index([visitedAt])
}

// 事件追踪表 - 记录用户的关键交互行为
model EventTrack {
  id            String   @id @default(cuid())
  analyticsId   String // 关联的会话ID
  eventName     String // 事件名称（如 recording_start, anchor_mark）
  eventCategory String? // 事件分类（如 recording, learning, ai）
  eventData     String? // 额外数据（JSON格式）
  createdAt     DateTime @default(now())

  analytics UserAnalytics @relation(fields: [analyticsId], references: [id], onDelete: Cascade)

  @@index([analyticsId])
  @@index([eventName])
  @@index([eventCategory])
  @@index([createdAt])
}

model WechatInboxMessage {
  id             String    @id @default(cuid())
  linkToken      String    @unique
  openId         String
  userId         String?
  workspaceId    String?
  developerId    String?
  msgType        String
  eventType      String?
  messageId      String?   @unique
  messageAt      DateTime?
  rawXml         String
  payloadJson    String
  normalizedText String?
  previewText    String?
  sourceUrl      String?
  mediaId        String?
  mediaUrl       String?
  title          String?
  reachKind      String?
  reachChannel   String?
  collectionRole String?
  bindingStatus  String    @default("unresolved")
  echoTitle      String?
  echoBody       String?
  echoChipsJson  String?
  tutorContext   String?
  replyText      String?
  processedAt    DateTime?
  status         String    @default("received")
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  user      User?      @relation(fields: [userId], references: [id], onDelete: SetNull)
  workspace Workspace? @relation(fields: [workspaceId], references: [id], onDelete: SetNull)

  @@index([openId])
  @@index([userId])
  @@index([workspaceId])
  @@index([msgType])
  @@index([eventType])
  @@index([bindingStatus])
  @@index([reachChannel])
  @@index([createdAt])
}

/// ASR 纠错记录 (M5 T5.1)
/// 用户在前端修改转写文本后，回写到服务端。
/// 周度聚合：高频 (wrongText, correctedText) 对 → 进入 userHotwords / workspaceHotwords。
model AsrCorrection {
  id            String   @id @default(cuid())
  userId        String?
  workspaceId   String?
  sessionId     String
  /// ASR 原始识别文本
  wrongText     String
  /// 用户修改后的正确文本
  correctedText String
  /// 被修改片段的音频时间戳（毫秒），便于回听
  beginMs       Int?
  endMs         Int?
  /// 可选：被修改片段的上下文（前后各 30 字）
  context       String?
  /// 来自哪个 ASR 模式：realtime / fast / async
  asrMode       String   @default("unknown")
  /// 是否已被周度聚合处理（进入热词字典）
  aggregated    Boolean  @default(false)
  createdAt     DateTime @default(now())

  user      User?      @relation(fields: [userId], references: [id], onDelete: SetNull)
  workspace Workspace? @relation(fields: [workspaceId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([workspaceId])
  @@index([sessionId])
  @@index([aggregated])
  @@index([createdAt])
}

/// 用户级 / Workspace 级个人热词（M5 T5.1）
/// 从 AsrCorrection 聚合而来。写入 Qwen3-ASR-Flash parameters.context 影响识别。
model AsrHotword {
  id          String    @id @default(cuid())
  /// 持有人：userId 或 workspaceId 二选一
  userId      String?
  workspaceId String?
  /// 正确写法（标准形式）
  term        String
  /// 可选：常见错误写法（方便 dedup）
  aliases     String?
  /// 权重：出现频次越高越重要
  weight      Float     @default(1.0)
  /// 来源：correction / manual / course
  source      String    @default("correction")
  lastUsedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user      User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([userId, term])
  @@unique([workspaceId, term])
  @@index([userId])
  @@index([workspaceId])
  @@index([weight])
}

// ==================== v3.0 SharedAgent — 场景上下文作为分享单元 ====================
//
// 设计参见 roadmap/v3.0-virality-agent.md。
//
// 一个 SharedAgent = 一个用户在某节课/讨论之后"刻"下来的可分享 Agent。
// 它持有 share-time snapshot（不可变），任何人凭 token 可访问；
// 登录用户可与之对话（走 /api/tutor/agent mode='shared'）或领取到自己 workspace。
//
// 隐私铁律：
//   - snapshotJson 永远不包含原作者的对话历史 / 学习者画像 / 个人层应用产物
//   - 默认只装"场景上下文"：转录摘要 + 选定的产物 (cheatsheet/mindmap/quiz/...) + 课名
//   - 个人层数据仅在用户分享时显式勾选才进入 snapshot

/// 一个被分享出去的 Agent 快照
model SharedAgent {
  id              String  @id @default(cuid())
  /// 公开访问的短 token（URL 安全，~12 字符）
  token           String  @unique
  /// 创建分享的用户和 workspace（用户注销时保留 SharedAgent，因此用 SetNull）
  ownerId         String?
  workspaceId     String?
  /// 来源 IndexedDB sessionId（用于本地引用、不构成跨用户主键）
  sourceSessionId String?
  /// 标题（课程名 / 讨论主题）
  title           String
  /// 学科 / 上下文
  subject         String?
  /// 分享的核心产物类型：
  ///   cheatsheet | mindmap | quiz | flashcards | infographic | audio-overview | notes | chat-only
  artifactKind    String
  /// snapshot 数据：见 SharedAgentSnapshot 类型定义。一次性刻死，不随源更新。
  snapshotJson    String
  /// 分享者展示昵称（不带真实姓名，避免社工）
  sharerNickname  String?
  /// 隐私 / 可见性：public（任何人持链接可看）/ unlisted（不可被搜索）/ class（保留）
  visibility      String  @default("public")
  /// 是否允许对方对话（false = 只读分享图）
  conversationEnabled Boolean @default(true)
  /// 浏览次数
  viewCount       Int     @default(0)
  /// 领取次数
  claimCount      Int     @default(0)
  /// 对话次数
  chatCount       Int     @default(0)
  /// 状态：active / revoked
  status          String  @default("active")
  expiresAt       DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  owner        User?              @relation("SharedAgentOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  workspace    Workspace?         @relation("SharedAgentWorkspace", fields: [workspaceId], references: [id], onDelete: SetNull)
  interactions ShareInteraction[]
  claims       ShareClaim[]

  @@index([token])
  @@index([ownerId])
  @@index([workspaceId])
  @@index([artifactKind])
  @@index([status])
  @@index([createdAt])
}

/// 分享 Agent 的访问/对话/转发埋点
model ShareInteraction {
  id            String   @id @default(cuid())
  shareId       String
  /// 访问者 userId（如果登录）；匿名访问时为 null
  visitorUserId String?
  /// 事件类型：view | chat | claim | reshare
  eventType     String
  /// 可选携带数据（chat 摘要、user-agent 等）
  metadataJson  String?
  createdAt     DateTime @default(now())

  share   SharedAgent @relation(fields: [shareId], references: [id], onDelete: Cascade)
  visitor User?       @relation("ShareInteractionVisitor", fields: [visitorUserId], references: [id], onDelete: SetNull)

  @@index([shareId])
  @@index([visitorUserId])
  @@index([eventType])
  @@index([createdAt])
}

/// 把一个 SharedAgent 领取到自己 workspace 的记录（一对一）
model ShareClaim {
  id              String   @id @default(cuid())
  shareId         String
  claimerUserId   String
  claimerWorkspaceId String?
  /// 领取后在 claimer workspace 创建的 capture id（可空，若领取流程没立刻造 capture）
  capturedItemId  String?
  createdAt       DateTime @default(now())

  share   SharedAgent @relation(fields: [shareId], references: [id], onDelete: Cascade)
  claimer User        @relation("ShareClaimer", fields: [claimerUserId], references: [id], onDelete: Cascade)

  @@unique([shareId, claimerUserId])
  @@index([claimerUserId])
  @@index([claimerWorkspaceId])
  @@index([createdAt])
}

/// AgentPack — 用户主动打包的"上下文包"（v3.1 北极星 / R9 单元 Agent）
///
/// 把 N 节课打包成一个"单元"或"考试" Agent。同桌进入这个 Agent 时，
/// 加载 ContextPack { tier, lessons[] } 作为对话上下文；应用矩阵按
/// supportedTiers.includes(tier) 过滤可用 plugins。
///
/// 数据结构故意保持极简：
///   - lessonIds 是 IndexedDB 的 sessionId 数组（JSON string，保留顺序）
///   - 不存 lesson 内容本身（每次进入时由客户端 buildPackFromMultipleSessions 拼出）
///   - 这样不污染服务端，IndexedDB 是真相源
model AgentPack {
  id          String   @id @default(cuid())
  userId      String
  /// 上下文层级：unit | exam（class 不在此表，因为单课 Agent = AudioSession 自身）
  tier        String
  /// 用户起的名字（如"经济学 第三章"、"期末综合"）
  name        String
  /// IndexedDB sessionId 数组，JSON string，保留用户多选时的顺序
  lessonIdsJson String
  /// 学科 / 主题（可选，给应用矩阵 prompt 的提示用）
  subject     String?
  /// 备考时段 / 考试日期（可选，仅 tier='exam' 用）
  examDate    DateTime?
  /// 软删除标记
  archivedAt  DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation("UserAgentPacks", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, tier])
  @@index([userId, archivedAt])
  @@index([createdAt])
}
